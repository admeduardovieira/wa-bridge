# ============================================================
# wa-bridge Configuration
# Copy this file to .env and fill in your values: cp .env.example .env
# ============================================================

# LLM Endpoint — OpenAI-compatible API URL
# Leave blank to disable LLM responses (message forwarding only)
# Examples:
#   OpenAI:        https://api.openai.com/v1/chat/completions
#   Anthropic:     https://api.anthropic.com/v1/messages
#   Solar:         https://api.upstage.ai/v1/solar/chat/completions
#   Local (Ollama): http://localhost:11434/v1/chat/completions
LLM_ENDPOINT=

# LLM API Key — required if endpoint needs authentication
# Generate from your LLM provider's dashboard
LLM_API_KEY=

# LLM Model name (e.g. gpt-4o, solar-pro4, claude-3-5-sonnet-20241022)
LLM_MODEL=solar-pro4

# Temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.7

# System prompt — how the bot should behave
LLM_SYSTEM_PROMPT=Você é um assistente de WhatsApp. Responda de forma natural, direta e útil.
Se a mensagem for um comando (ex: "!ajuda", "!sair"), responda de forma apropriada.
Para mensagens em grupo, só responde se for diretamente para você ou se for um comando.

# LLM request timeout (milliseconds)
LLM_TIMEOUT=30000

# ============================================================
# Bot Behavior
# ============================================================

# Response mode:
#   'always'  — respond to all messages
#   'direct'  — only respond to direct messages
#   'mention' — only respond when mentioned (default)
BEHAVIOR_MODE=mention

# Command prefix for bot commands
COMMAND_PREFIX=!

# Comma-separated list of authorized admin numbers (international format, no +)
# Leave blank to allow all users to use commands
ADMIN_NUMBERS=

# Group response mode:
#   'mention' — only respond when mentioned in group
#   'always'  — respond to all messages in group
GROUP_MODE=mention

# ============================================================
# Session / Connection
# ============================================================

# Directory to store WhatsApp session credentials (persistent login)
SESSION_DIR=./session

# Log level: debug | info | warn | error
LOG_LEVEL=info
